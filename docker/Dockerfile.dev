# Minimal dev-iteration container for ntgcalls.
# Builds against the prebuilt libwebrtc tarball (Linux ubuntu-22.04 x86_64).
# Faster than the manylinux2014 production build which rebuilds LLVM.

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ninja-build git ca-certificates curl \
    python3 python3-pip python3-dev python3-venv \
    pkg-config \
    libssl-dev zlib1g-dev \
    libasound2-dev libpulse-dev \
    libx11-dev libxext-dev libxcomposite-dev libxdamage-dev libxfixes-dev libxrandr-dev libxrender-dev libxtst-dev \
    libgl1-mesa-dev libegl1-mesa-dev libgles2-mesa-dev libdrm-dev libgbm-dev \
    libpci-dev libudev-dev \
    nasm yasm \
    && rm -rf /var/lib/apt/lists/*

# ntgcalls requires cmake >= 3.27; Ubuntu 22.04 ships 3.22. Install via pip.
RUN pip install --no-cache-dir --upgrade pip wheel setuptools scikit-build cmake

WORKDIR /work

# Copy the fork source (build context = repo root).
COPY . /work/ntgcalls

WORKDIR /work/ntgcalls

# First build is dominated by the libwebrtc tarball download (~200MB) which
# ntgcalls' FindWebRTC.cmake fetches on configure. Subsequent rebuilds reuse
# deps/libwebrtc unless explicitly cleared.
RUN cmake -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DIS_PYTHON=OFF \
    -DSTATIC_BUILD=ON
RUN cmake --build build -j$(nproc)
RUN ls -la build/ntgcalls/ build/wrtc/ 2>&1 | head -20
